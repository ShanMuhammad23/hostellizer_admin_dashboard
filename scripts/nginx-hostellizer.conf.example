# Hostellizer admin — Nginx reverse proxy (HTTP on raw IP)
# Place in /etc/nginx/sites-available/hostellizer and symlink to sites-enabled.

server {
    listen 80;
    server_name 68.183.89.18;

    client_max_body_size 20M;

    location / {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Required so NextAuth sees the public URL (not 127.0.0.1:3002)
        proxy_set_header Cookie $http_cookie;
        proxy_pass_request_headers on;
    }
}
